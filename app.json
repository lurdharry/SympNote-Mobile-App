{
  "expo": {
    "name": "Sympnote: Symptom Tracker",
    "slug": "sympnote",
    "version": "1.1.3",
    "orientation": "portrait",
    "scheme": "sympnote",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sympnote.app",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sympnote uses the microphone so we can transcribe what you're saying about your symptoms.",
        "NSSpeechRecognitionUsageDescription": "Sympnote transcribes your voice on-device so your symptoms are ready to share with your doctor.",
        "NSPhotoLibraryUsageDescription": "Sympnote only accesses your photo library if you choose to save an exported brief to Photos from the system share sheet.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sympnote.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FEF8EE"
      },
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Sympnote uses the microphone so we can transcribe what you're saying about your symptoms.",
          "speechRecognitionPermission": "Sympnote transcribes your voice on-device so your symptoms are ready to share with your doctor.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "backgroundColor": "#FEF8EE",
          "resizeMode": "contain",
          "imageWidth": 220,
          "dark": {
            "image": "./assets/icon.png",
            "backgroundColor": "#FEF8EE"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          },
          "android": {
            "minSdkVersion": 30
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "16075850-44eb-4528-bc68-9682ee9ba338"
      }
    },
    "owner": "lurdharry"
  }
}
