{
  "expo": {
    "name": "Sympnote",
    "slug": "sympnote",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sympnote",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon-light.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sympnote.app",
      "icon": "./assets/icon-light.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sympnote uses the microphone so we can transcribe what you're saying about your symptoms.",
        "NSSpeechRecognitionUsageDescription": "Sympnote transcribes your voice on-device so your symptoms are ready to share with your doctor."
      }
    },
    "android": {
      "package": "com.sympnote.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-light.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Sympnote uses the microphone so we can transcribe what you're saying about your symptoms.",
          "speechRecognitionPermission": "Sympnote transcribes your voice on-device so your symptoms are ready to share with your doctor.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "backgroundColor": "#245353",
          "resizeMode": "contain",
          "imageWidth": 220,
          "dark": {
            "image": "./assets/icon.png",
            "backgroundColor": "#1B4846"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          },
          "android": {
            "minSdkVersion": 30
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
