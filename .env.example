# Copy to .env and fill in your keys.
# NEVER commit .env.
# TODO: Before production launch, move these calls behind a server-side
# proxy. Shipping API keys inside a mobile binary is unsafe — anyone can
# extract them from the bundle and run up your bill.

EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_dummy_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_dummy_key
