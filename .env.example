# Copy to .env and fill in your keys.
# NEVER commit .env.

# Gemini key is INSECURE bundled in the binary today — anyone can
# extract it from the IPA and run up your bill. Move all Gemini calls
# behind a server-side proxy before production launch.
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here

# RevenueCat keys are designed to be public — they're tied to a single
# app bundle and validated server-side. Safe to ship in the binary.
# Get yours from app.revenuecat.com → Project → API keys.
# Any value containing "dummy" disables the SDK and falls back to a
# clear error if the user tries to purchase or restore.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_dummy_key
